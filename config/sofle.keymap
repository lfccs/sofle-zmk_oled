#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

&mmv { time-to-max-speed-ms = <150>; };

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
        quick_tap_layer: quick_tap_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "QUICK_TAP_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <190>;
            tapping-term-ms = <200>;
        };

        mom_layers: mom_layers {
            compatible = "zmk,behavior-hold-tap";
            label = "MOM_LAYERS";
            bindings = <&mo>, <&mo>;

            #binding-cells = <2>;
            quick-tap-ms = <190>;
            tapping-term-ms = <200>;
        };

        sequencia: sequencia {
            compatible = "zmk,behavior-tap-dance";
            label = "SEQUENCIA";
            #binding-cells = <0>;
            bindings = <&kp A>, <&kp B>, <&kp C>;
        };

        hml: homerow_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 55 56 57 58 59>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            quick-tap-ms = <200>;
            hold-trigger-on-release;
        };

        hmr: homerow_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
        };
    };

    macros {
        teste: teste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp E &kp S &kp T &kp E>;
            label = "TESTE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp GRAVE  &kp N1           &kp N2           &kp N3             &kp N4        &kp N5                                     &kp N6                        &kp N7        &kp N8              &kp N9            &kp N0                    &sequencia
&kp ESC    &kp Q            &kp W            &kp E              &kp R         &kp T                                      &kp Y                         &kp U         &kp I               &kp O             &kp P                     &kp BACKSLASH
&kp TAB    &hml LEFT_GUI A  &hml LEFT_ALT S  &hml LEFT_SHIFT D  &hml LCTRL F  &kp G                                      &kp H                         &hmr RCTRL J  &hmr RIGHT_SHIFT K  &hmr RIGHT_ALT L  &hmr RIGHT_GUI SEMICOLON  &kp SQT
&kp LSHFT  &kp Z            &kp X            &kp C              &kp V         &kp B            &kp CAPS       &tog 5     &kp N                         &kp M         &kp COMMA           &kp DOT           &kp FSLH                  &kp RSHFT
                            &kp LGUI         &kp LALT           &kp LCTRL     &mom_layers 2 4  &lt 1 SPACE    &lt 1 RET  &quick_tap_layer 3 BACKSPACE  &kp RCTRL     &kp RALT            &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp F24 F23>, <&inc_dec_kp F22 F21>;
        };

        lower_layer {
            display-name = "lower";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans  &kp F1    &kp F2      &kp F3            &kp F4             &kp F5                       &trans  &kp FSLH  &kp STAR  &trans     &kp F6   &kp F7
&trans  &kp EXCL  &kp CARET   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PRCNT                    &kp N7  &kp N8    &kp N9    &kp MINUS  &kp F8   &kp F9
&trans  &kp AT    &kp AMPS    &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp EQUAL                    &kp N4  &kp N5    &kp N6    &kp PLUS   &kp F10  &kp F11
&trans  &kp HASH  &kp DOLLAR  &kp LPAR          &kp RPAR           &kp MINUS  &trans    &trans  &kp N1  &kp N2    &kp N3    &kp RET    &kp F12  &trans
                  &trans      &trans            &trans             &trans     &trans    &trans  &trans  &kp N0    &kp DOT   &kp COMMA
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &bt BT_PRV      &bt BT_NXT      &trans        &trans           &trans  &trans
&trans      &trans        &kp INSERT    &kp HOME      &kp PG_UP     &trans                          &mkp LCLK       &mkp MCLK       &mkp RCLK     &trans           &trans  &trans
&trans      &trans        &kp DEL       &kp END       &kp PG_DN     &trans                          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans      &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &trans        &trans    &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans  &trans
                          &trans        &trans        &trans        &trans        &trans    &trans  &trans          &trans          &trans        &trans
            >;
        };

        acentos {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans            &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans            &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp SINGLE_QUOTE  &kp GRAVE  &kp TILDE  &kp CARET  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans            &trans     &trans     &trans     &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans            &trans     &trans
            >;
        };

        nav_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                       &trans  &trans    &trans    &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &trans  &kp HOME  &kp UP    &kp END    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans  &trans    &trans    &trans     &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &kp LCTRL  &trans  &trans    &trans    &trans
            >;
        };

        games {
            bindings = <
&kp ESC    &kp N1  &kp N2    &kp N3  &kp N4  &kp N5                            &kp N6    &kp N7     &kp N8     &kp N9   &kp N0  &kp BSPC
&kp TAB    &kp Q   &kp W     &kp E   &kp R   &kp T                             &kp Y     &kp U      &kp I      &kp O    &kp P   &trans
&kp LSHFT  &kp A   &kp S     &kp D   &kp F   &kp G                             &kp H     &kp J      &kp K      &kp L    &trans  &trans
&kp LCTRL  &kp Z   &kp X     &kp C   &kp V   &kp B     &trans       &trans     &kp N     &kp M      &kp COMMA  &kp DOT  &trans  &trans
                   &kp LGUI  &trans  &trans  &kp LALT  &kp SPACE    &kp ENTER  &kp RALT  &kp RCTRL  &trans     &trans
            >;
        };
    };
};
